<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.ming-research.wf-board</string>
  <key>ProgramArguments</key><array><string>{{NODE}}</string><string>{{REPO}}/src/main.ts</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{{PATH}}</string><key>WF_BOARD_DATA</key><string>{{DATA}}</string>{{SESSIONS}}</dict>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>1</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/wf-board.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/wf-board.log</string>
</dict></plist>
